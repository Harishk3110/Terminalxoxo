{
  "uid": "knk-platform",
  "title": "KnK Platform Overview",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "timezone": "Asia/Singapore",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "API scrape availability", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "knk-prometheus"}, "targets": [{"refId": "A", "expr": "up{job=\"knk-api\"}"}]},
    {"id": 2, "title": "Request rate by status", "type": "timeseries", "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8}, "datasource": {"type": "prometheus", "uid": "knk-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(knk_api_requests_total[5m]))", "legendFormat": "{{status}}"}]},
    {"id": 3, "title": "95th percentile API latency (seconds)", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "knk-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, path) (rate(knk_api_request_seconds_bucket[5m])))", "legendFormat": "{{path}}"}]},
    {"id": 4, "title": "Data jobs by state", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "knk-prometheus"}, "targets": [{"refId": "A", "expr": "knk_jobs_by_state", "legendFormat": "{{state}}"}]},
    {"id": 5, "title": "Authentication failures (5 minutes)", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "knk-prometheus"}, "targets": [{"refId": "A", "expr": "increase(knk_auth_failures_total[5m])"}]},
    {"id": 6, "title": "Ingested records by provider", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "knk-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (provider) (increase(knk_data_records_ingested_total[5m]))", "legendFormat": "{{provider}}"}]}
  ]
}
