{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["KNK_API_URL", "NEXT_PUBLIC_API_BASE_URL", "NEXT_PUBLIC_APP_ENV", "NEXT_PUBLIC_DEMO_MODE", "NEXT_PUBLIC_TERMINAL_NAME", "VERCEL"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
