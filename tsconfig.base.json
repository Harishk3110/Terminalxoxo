{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@knk/design-system": ["packages/design-system/src/index.tsx"],
      "@knk/domain": ["packages/domain/src/index.ts"],
      "@knk/terminal-functions": ["packages/terminal-functions/src/index.ts"],
      "@knk/search": ["packages/search/src/index.ts"]
    }
  }
}
